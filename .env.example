# Local / IntelliJ. Docker overrides via env/story.env on the server.
# Infra MySQL host port is 3307.

DB_URL=jdbc:mysql://127.0.0.1:3307/story_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=story_user
DB_PASSWORD=story_pass
JPA_DDL_AUTO=update
EUREKA_CLIENT_ENABLED=false
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
SERVER_PORT=0
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
STORY_KAFKA_CONSUMER_ENABLED=false
STORY_OUTBOX_ENABLED=false
